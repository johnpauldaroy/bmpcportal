# ====================================================================
# Self-hosted Supabase stack config (deploy/docker-compose.yml).
# Copy to deploy/.env and fill in. NEVER commit deploy/.env.
# ====================================================================

# --- Postgres ---
POSTGRES_DB=postgres
# Strong password; used by every internal service to reach the DB.
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- JWT / API keys ---
# JWT_SECRET: a random 40+ char secret. Generate with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_40_plus_char_random_secret
JWT_EXPIRY=3600

# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET above.
# They are NOT random strings — generate them after you set JWT_SECRET with:
#   ./generate-keys.sh
# Then paste the two outputs here.
ANON_KEY=CHANGE_ME_anon_jwt
SERVICE_ROLE_KEY=CHANGE_ME_service_role_jwt

# --- Public URLs ---
# The domain Dokploy serves this stack on (Kong, port 8000). This is exactly
# what NEXT_PUBLIC_SUPABASE_URL in the app must be set to.
SUPABASE_PUBLIC_URL=https://api.your-domain.com
# Your app's URL (used for auth redirects / email links).
SITE_URL=https://portal.your-domain.com
ADDITIONAL_REDIRECT_URLS=https://portal.your-domain.com

# --- Auth behavior ---
# Keep registration open (the app has its own /register flow). Set true to lock.
DISABLE_SIGNUP=false
# true = users are usable immediately without clicking an email link. The app's
# own status workflow gates access, so autoconfirm is fine and avoids needing
# email delivery for basic login. Set false to require email confirmation.
MAILER_AUTOCONFIRM=true

# --- Storage ---
# Hard cap per uploaded file at the storage layer (defense in depth). The loan
# forms enforce 2MB; leave headroom here for other buckets (CSV/knowledge).
STORAGE_FILE_SIZE_LIMIT=52428800

# --- SMTP (reused by GoTrue for auth emails; same creds as the app) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=it@barbazampc.coop
SMTP_PASSWORD=CHANGE_ME_app_password
SMTP_ADMIN_EMAIL=it@barbazampc.coop
SMTP_SENDER_NAME=BMPC Portal
