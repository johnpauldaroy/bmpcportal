# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="BMPC Portal"

# Supabase public browser/server anon access
NEXT_PUBLIC_SUPABASE_URL=https://dxpphuixuhmxrzmlrgjk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_3Qb2pM9y7rpBZguFFBLang_2jLjjlFQ

# Server-only Supabase access. Never expose this to client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local/dev seed users. Override these before running npm run seed:users.
BMP_ADMIN_EMAIL=admin@barbazampc.coop
BMP_ADMIN_PASSWORD=password
BMP_MEMBER_EMAIL=member@barbazampc.coop
BMP_MEMBER_PASSWORD=password
BMP_MEMBER_NUMBER=BMPC-0001

# OpenRouter chat API. Use openrouter/free or an explicit model ending in :free.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Security and operations
IMPORT_SIGNING_SECRET=replace-with-strong-random-value
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_RATE_LIMIT_MAX_REQUESTS=60

# SMTP email delivery. Leave SMTP_HOST blank to disable sending (the app will
# log the email instead, so dev works without a mail server).
# Example for Gmail: host smtp.gmail.com, port 587, secure false, user = your
# address, password = a Google "App Password" (not your login password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BMPC Portal <no-reply@barbazampc.coop>"
